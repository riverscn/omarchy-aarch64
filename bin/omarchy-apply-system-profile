#!/bin/bash

# omarchy:summary=Apply optional system profile policy to user configuration
# omarchy:hidden=true

set -euo pipefail

profile_dir="${OMARCHY_SYSTEM_PROFILE_DIR:-/usr/share/omarchy/system}"
shell_config="${OMARCHY_SHELL_CONFIG:-$HOME/.config/omarchy/shell.json}"
shell_filter="$profile_dir/shell-defaults.jq"

[[ -f $shell_filter && -f $shell_config ]] || exit 0

stage=$(mktemp "$(dirname -- "$shell_config")/.shell.json.profile.XXXXXX")
cleanup() {
  [[ -z $stage ]] || rm -f -- "$stage"
}
trap cleanup EXIT

jq -f "$shell_filter" "$shell_config" >"$stage"
if ! cmp -s "$stage" "$shell_config"; then
  chmod --reference="$shell_config" "$stage"
  mv -f -- "$stage" "$shell_config"
  stage=""
fi
